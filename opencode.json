{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "laravel-boost": {
                "type": "local",
                "command": ["php", "artisan", "boost:mcp"]
            },
            "shadcn": {
                "type": "local",
                "command": ["pnpm", "exec", "shadcn", "mcp"]
            }
        },
        "timeout": {
            "startup": 60000
        }
    }
}
