includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7
    treatPhpDocTypesAsCertain: false   # silences the two "array_values has no effect" notes
    ignoreErrors:
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Relations\\Pivot::\$(role|joined_at)#'
